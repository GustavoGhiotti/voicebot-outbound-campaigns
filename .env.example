# =============================================================================
# Envio Ativo VOXI - modelo de configuracao
# Copie para .env e preencha com os valores reais. NUNCA coloque valores
# reais neste arquivo: ele e versionado.
#   Copy-Item .env.example .env
# =============================================================================

# --- Banco principal (10.0.0.71) - origem dos clientes e quarentena --------
# Obrigatorias: DB_HOST, DB_USER, DB_PASSWORD
DB_HOST=10.0.0.71
DB_NAME=DB_REPORT
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 17 for SQL Server

# --- Banco de controle de execucao (10.0.0.66 / LOGS_ROBOS) ---------------
# Reutiliza DB_USER e DB_PASSWORD. Opcionais: assumem o valor abaixo.
LOGS_DB_HOST=10.0.0.66
LOGS_DB_NAME=LOGS_ROBOS

# --- Cadastro das carteiras (10.0.0.66 / DB_SFTP) -------------------------
# Onde fica a TB_CARTEIRA_VOXI, que diz servidor/banco/schema/procedure de
# cada carteira. Reutiliza DB_USER e DB_PASSWORD.
# Incluir carteira nova e INSERT nessa tabela, sem alterar codigo.
CADASTRO_DB_HOST=10.0.0.66
CADASTRO_DB_NAME=DB_SFTP

# --- SFTP da VOXI (destino dos arquivos) ------------------------------------
# Obrigatorias: SFTP_HOST, SFTP_USER.
# Autentique por senha (SFTP_PASSWORD) OU por chave (SFTP_KEY_FILE).
SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_KEY_FILE=
SFTP_REMOTE_DIR=/home/usuario_sftp

# --- Saida local dos arquivos gerados ---------------------------------------
# Caminho absoluto (UNC aceito). Se for relativo, e resolvido a partir da raiz
# do projeto. O robo cria as subpastas AAAA/MM/DD.
VOXI_OUTPUT_DIR=\\10.0.0.71\d\Automacao\VOXI

# =============================================================================
# Somente para o fluxo de REMESSAS (scripts.executar_remessas)
# =============================================================================

# Raiz do RoboCargas, de onde saem o .env complementar e as chaves dos cedentes
ROBO_CARGAS_ROOT=C:\Robos\RoboCargas

# Banco com o cadastro de FTP/SFTP dos cedentes (Carga.TB_CONEXAO_SFTP).
# Se ausentes, caem para DB_66 e depois para o padrao 10.0.0.66, e as
# credenciais caem para DB_SENHA e depois para DB_USER / DB_PASSWORD.
CARGAS_DB_HOST=10.0.0.66
CARGAS_DB_NAME=DB_DESENVOLVIMENTO
CARGAS_DB_USER=
CARGAS_DB_PASSWORD=
CARGAS_DB_DRIVER=SQL Server
DB_66=10.0.0.66
DB_SENHA=

# =============================================================================
# OBSOLETO - nao e lido por nenhum codigo desde a Fase 5.
# O filtro de cada carteira passou a ficar no catalogo de settings.py
# (funcao obter_carteiras). Mantido apenas para documentar o que foi removido.
# VOXI_CARTEIRA_ZETA, VOXI_CARTEIRA_TETA, VOXI_CARTEIRA_BETA,
# VOXI_CARTEIRA_MU, VOXI_CARTEIRA_IMOB, VOXI_CARTEIRA_NU
# =============================================================================
